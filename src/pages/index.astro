---
import '../styles/global.css';
import { AppTabs } from '../components/AppTabs';

const rawBasePath = import.meta.env.BASE_URL || '/';
const basePath = rawBasePath.endsWith('/') ? rawBasePath : `${rawBasePath}/`;
const faviconUrl = `${basePath}favicon.svg`;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${basePath}icons/icon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${basePath}icons/icon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${basePath}icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${basePath}manifest.webmanifest`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="3D Reference" />
    <meta name="description" content="Interactive 3D reference studio, Loomis head fitting, hand poser, digital pigment palette mixer, and procedural geometry generator." />
    <meta name="generator" content={Astro.generator} />
    <title>🎨 3D Studio & Artist Reference Generator</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen" data-base-path={basePath}>
    <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col gap-6">
      {/* Header */}
      <header class="bg-gradient-to-r from-slate-900 via-slate-850 to-slate-900 border border-slate-800 p-6 rounded-3xl shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-0">
          <a href="https://www.handsonart.studio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4">
            <img class="logo mx-auto md:mx-0 md:mr-10" src={`${basePath}images/logo-dark.svg`} alt="Hands On Art Studio Logo">
          </a>
          <div>
            <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-purple-300 to-amber-300">
              🎨 3D Artist Reference Generator
            </h1>
            <p class="text-xs text-slate-400 mt-1">Digital studio tools for artists &amp; illustrators</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <!-- PWA Install Button -->
          <button
            id="pwa-install-btn"
            class="hidden items-center gap-2 px-4 py-2 bg-gradient-to-r from-sky-600 via-indigo-600 to-purple-600 hover:from-sky-500 hover:to-purple-500 text-white font-semibold text-xs rounded-xl shadow-lg shadow-sky-950/40 border border-sky-400/30 transition-all cursor-pointer"
            title="Install as Progressive Web App"
          >
            <span class="text-sm">📥</span>
            <span>Install App</span>
          </button>

          <!-- Offline Mode Indicator -->
          <span
            id="offline-badge"
            class="hidden items-center gap-1.5 px-3 py-1.5 bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs rounded-xl font-medium"
            title="Running in offline mode with cached studio tools"
          >
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>Offline</span>
          </span>

          <a 
            href="https://ko-fi.com/handsonartstudio" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="kofi-header-btn"
          >
            <span class="cup-icon">☕</span>
            <span>Fuel the Dev on Ko-fi</span>
          </a>
        </div>
      </header>

      {/* Main Interactive App */}
      <main>
        <AppTabs client:load basePath={basePath} />
      </main>

      {/* Footer */}
      <footer class="text-center text-xs text-slate-500 py-6 border-t border-slate-900 mt-8">
        Created and hosted by Hands On Art Studio
      </footer>
    </div>

    {/* Tipping Modal */}
    <div
      id="tip-modal"
      class="modal-backdrop"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tip-modal-title"
    >
      <div class="modal-card">
        <button id="close-tip-modal" class="close-btn" aria-label="Close modal">&times;</button>
        <div class="modal-icon">🎨 ☕</div>
        <h3 id="tip-modal-title">Reference Saved!</h3>
        <p>Hope this angle nails your sketch. This tool is independent and 100% free with no ads. If it saved you time, consider tossing a buck in the jar to keep updates rolling.</p>
        
        <div class="modal-actions">
          <a 
            href="https://ko-fi.com/handsonartstudio" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="modal-kofi-btn"
          >
            Tip on Ko-fi
          </a>
          <button id="dismiss-tip-btn" class="modal-cancel-btn">Back to Drawing</button>
        </div>
      </div>
    </div>

    <script>
      const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
      const STORAGE_KEY = 'kofi_modal_last_shown';
      const LEGACY_STORAGE_KEY = 'kofi_modal_dismissed';

      function shouldShowModal(): boolean {
        const lastTimestampStr = localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_STORAGE_KEY);
        if (!lastTimestampStr) return true;
        const lastTimestamp = parseInt(lastTimestampStr, 10);
        if (isNaN(lastTimestamp)) return true;
        return Date.now() - lastTimestamp >= SEVEN_DAYS_MS;
      }

      function triggerTipModal(force = false) {
        if (!force && !shouldShowModal()) {
          return;
        }

        const modal = document.getElementById('tip-modal');
        if (modal) {
          modal.classList.add('active');
          modal.setAttribute('aria-hidden', 'false');
          const nowStr = Date.now().toString();
          localStorage.setItem(STORAGE_KEY, nowStr);
          localStorage.setItem(LEGACY_STORAGE_KEY, nowStr);
        }
      }

      function hideModal() {
        const modal = document.getElementById('tip-modal');
        if (modal) {
          modal.classList.remove('active');
          modal.setAttribute('aria-hidden', 'true');
          const nowStr = Date.now().toString();
          localStorage.setItem(STORAGE_KEY, nowStr);
          localStorage.setItem(LEGACY_STORAGE_KEY, nowStr);
        }
      }

      function setupModal() {
        const modal = document.getElementById('tip-modal');
        const closeBtn = document.getElementById('close-tip-modal');
        const dismissBtn = document.getElementById('dismiss-tip-btn');

        if (closeBtn) closeBtn.addEventListener('click', hideModal);
        if (dismissBtn) dismissBtn.addEventListener('click', hideModal);

        // Light dismiss: clicking on backdrop outside modal card
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) {
              hideModal();
            }
          });
        }

        // Close on Escape key
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal?.classList.contains('active')) {
            hideModal();
          }
        });

        // Listen for export event
        window.addEventListener('trigger-tip-modal', () => {
          triggerTipModal();
        });
      }

      // Expose globally for convenience & testing
      (window as any).triggerTipModal = triggerTipModal;
      (window as any).hideTipModal = hideModal;

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupModal);
      } else {
        setupModal();
      }

      // --- Progressive Web App (PWA) Logic ---
      const basePath = document.body.dataset.basePath || '/';
      let deferredPrompt: any = null;
      const installBtn = document.getElementById('pwa-install-btn');
      const offlineBadge = document.getElementById('offline-badge');

      // Check if running as installed standalone PWA
      const isStandalone = window.matchMedia('(display-mode: standalone)').matches ||
                           (window.navigator as any).standalone === true;

      // Handle install prompt
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (installBtn && !isStandalone) {
          installBtn.classList.remove('hidden');
          installBtn.classList.add('flex');
        }
      });

      if (installBtn) {
        installBtn.addEventListener('click', async () => {
          if (!deferredPrompt) return;
          deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === 'accepted') {
            installBtn.classList.add('hidden');
            installBtn.classList.remove('flex');
          }
          deferredPrompt = null;
        });
      }

      window.addEventListener('appinstalled', () => {
        if (installBtn) {
          installBtn.classList.add('hidden');
          installBtn.classList.remove('flex');
        }
        deferredPrompt = null;
        console.log('[PWA] 3D Artist Reference Studio was installed successfully.');
      });

      // Handle offline/online status indicators
      function updateNetworkStatus() {
        if (!navigator.onLine) {
          offlineBadge?.classList.remove('hidden');
          offlineBadge?.classList.add('flex');
        } else {
          offlineBadge?.classList.add('hidden');
          offlineBadge?.classList.remove('flex');
        }
      }
      window.addEventListener('online', updateNetworkStatus);
      window.addEventListener('offline', updateNetworkStatus);
      updateNetworkStatus();

      // Register Service Worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const swUrl = `${basePath}sw.js`.replace(/\/+/g, '/');
          navigator.serviceWorker
            .register(swUrl, { scope: basePath })
            .then((registration) => {
              console.log('[PWA] Service Worker registered with scope:', registration.scope);
              registration.addEventListener('updatefound', () => {
                const installingWorker = registration.installing;
                if (installingWorker) {
                  installingWorker.addEventListener('statechange', () => {
                    if (installingWorker.state === 'installed' && navigator.serviceWorker.controller) {
                      console.log('[PWA] New version ready! Content updated in background.');
                    }
                  });
                }
              });
            })
            .catch((err) => {
              console.warn('[PWA] Service Worker registration failed:', err);
            });
        });
      }
    </script>
  </body>
</html>
